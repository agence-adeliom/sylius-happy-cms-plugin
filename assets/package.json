{
  "name": "@agence-adeliom/sylius-happy-cms-assets",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "requires": true,
  "engineStrict": true,
  "symfony": {
    "controllers": {
      "page-tree-tree": {
        "main": "controllers/PageTreeController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "page-tree-delete": {
        "main": "controllers/DeletePageController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "menu-item-tree-tree": {
        "main": "controllers/MenuItemTreeController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "menu-item-tree-delete": {
        "main": "controllers/DeleteMenuItemController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "builder-block-editor": {
        "main": "controllers/BlockEditor.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "media-manager": {
        "main": "controllers/MediaManagerController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": false
      },
      "media-field": {
        "main": "controllers/MediaFieldController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": false
      }
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "@agence-adeliom/easy-media-manager": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@agence-adeliom/easy-media-manager": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0"
  }
}
