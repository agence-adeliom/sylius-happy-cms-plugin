{
    "name": "agence-adeliom/sylius-happy-cms-plugin",
    "type": "sylius-plugin",
    "description": "A simple lightweight CMS bundle for Symfony Sylius",
    "keywords": [
        "symfony",
        "sylius",
        "cms",
        "editorial content",
        "symfony-ux"
    ],
    "homepage": "https://github.com/agence-adeliom/sylius-happy-cms-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Community contributions",
            "homepage": "https://github.com/agence-adeliom/sylius-happy-cms-plugin/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.4 || ^8.5",
        "ext-exif": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "agence-adeliom/sylius-easy-crud-plugin": "~2.3.0@dev",
        "emileperron/tinymce-bundle": "^3.0",
        "illuminate/support": "^v11.33.2",
        "james-heinrich/getid3": "^1.9",
        "league/flysystem-bundle": "^2.4.0 || ^3.0",
        "liip/imagine-bundle": "^2.8",
        "maennchen/zipstream-php": "^2.1.0",
        "presta/sitemap-bundle": "^v4.1.1",
        "stof/doctrine-extensions-bundle": "^1.6",
        "sylius/sylius": "^v2.3.0-alpha.1",
        "symfony-cmf/routing-bundle": "^3.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/options-resolver": "^7.4 || ^8.0",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/serializer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "behat/behat": "^3.16 || ^4.0@alpha",
        "behat/mink": "^1.13",
        "dbrekelmans/bdi": "^1.4",
        "dmore/behat-chrome-extension": "^1.4 || dev-main@dev",
        "dmore/chrome-mink-driver": "^2.9",
        "friends-of-behat/mink-browserkit-driver": "^1.6.3",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.7 || ^3.0@alpha",
        "friends-of-behat/page-object-extension": "^0.3",
        "friends-of-behat/symfony-extension": "^2.6",
        "friends-of-behat/variadic-extension": "^1.6",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "robertfausk/behat-panther-extension": "^1.1 || ^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius-labs/suite-tags-extension": "~0.2",
        "sylius/test-application": "^v2.3.0-ALPHA.2",
        "symfony/ai-bundle": "^0.3.2",
        "symfony/ai-chat": "^0.3.0",
        "symfony/ai-open-ai-platform": "^0.3.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/maker-bundle": "^1.67",
        "symfony/runtime": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.3-dev"
        },
        "symfony": {
            "require": "^7.4 || ^8.0"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Adeliom\\SyliusHappyCMSPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Adeliom\\SyliusHappyCMSPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    }
}
