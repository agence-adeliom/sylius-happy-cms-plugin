{
  "name": "agence-adeliom/sylius-happy-cms-plugin",
  "type": "symfony-bundle",
  "description": "A simple lightweight CMS bundle for Symfony Sylius",
  "keywords": [
    "symfony",
    "sylius",
    "cms",
    "editorial content"
  ],
  "homepage": "https://github.com/agence-adeliom/sylius-happy-cms-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Community contributions",
      "homepage": "https://github.com/agence-adeliom/sylius-happy-cms-plugin/graphs/contributors"
    }
  ],
  "require": {
    "php": "~8.1|~8.2|~8.3",
    "agence-adeliom/sylius-easy-crud-plugin": "^v1.13.0",
    "symfony/webpack-encore-bundle": "^1.12 || ^2.0",
    "ext-json": "*",
    "ext-intl": "*",
    "ext-exif": "*",
    "sylius/sylius": "^v1.13.0 || ^v2.0",
    "symfony-cmf/routing-bundle": "^3.0",
    "symfony/filesystem": "^6.4 || ^7.0",
    "symfony/options-resolver": "^6.4 || ^7.0",
    "symfony/property-access": "^6.4 || ^7.0",
    "league/flysystem-bundle": "^2.4.0 || ^3.0",
    "liip/imagine-bundle": "^2.8",
    "maennchen/zipstream-php": "^2.1.0",
    "illuminate/support": "^9.2",
    "stof/doctrine-extensions-bundle": "^1.6",
    "symfony/psr-http-message-bridge": "^2.0",
    "nyholm/psr7": "^1.4",
    "presta/sitemap-bundle": "^4.2",
    "james-heinrich/getid3": "^1.9"
  },
  "conflict": {
    "symfony/framework-bundle": "6.2.8"
  },
  "require-dev": {
    "friendsoftwig/twigcs": "^6.4 || ^v7.0",
    "lchrusciel/api-test-case": "^5.0",
    "phpmd/phpmd": "^2.15",
    "phpspec/phpspec": "^7.0",
    "phpstan/extension-installer": "^1.0",
    "phpstan/phpstan": "^1.8.4",
    "phpstan/phpstan-doctrine": "^1.3.2",
    "phpstan/phpstan-webmozart-assert": "^1.1",
    "phpunit/phpunit": "^9.6",
    "symplify/easy-coding-standard": "^12.0",
    "symfony/browser-kit": "^6.4 || ^v7.0",
    "symfony/debug-bundle": "^6.4 || ^v7.0",
    "symfony/dotenv": "^6.4 || ^v7.0",
    "symfony/intl": "^6.4 || ^v7.0",
    "symfony/yaml": "^6.4 || ^v7.0",
    "symfony/maker-bundle": "^1.60",
    "symfony/web-profiler-bundle": "^6.4 || ^v7.0",
    "vimeo/psalm": "5.23.1"
  },
  "autoload": {
    "psr-4": {
      "Adeliom\\SyliusHappyCMSPlugin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Adeliom\\SyliusHappyCMSPlugin\\Tests\\": "tests/PHPUnit/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "0.x-dev"
    }
  },
  "scripts": {
    "auto-scripts": {
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": true
    }
  }
}
