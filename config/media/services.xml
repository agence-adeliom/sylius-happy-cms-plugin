<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true"/>

        <service id="happy.cms.media.controller" class="Adeliom\SyliusHappyCMSPlugin\Controller\Media\MediaController" public="true" autowire="true">
            <argument key="$manager" type="service" id="happy.cms.media.manager"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="Adeliom\SyliusHappyCMSPlugin\Controller\Media\MediaController" alias="happy.cms.media.controller" public="true"/>

        <service id="happy.cms.media.manager" class="Adeliom\SyliusHappyCMSPlugin\Services\Media\MediaManager" public="true" autowire="true">
            <argument key="$filesystem" type="service" id="happy.cms.media.storage"/>
            <argument key="$helper" type="service" id="happy.cms.media.helper"/>
            <argument key="$em" type="service" id="doctrine.orm.entity_manager"/>
            <argument key="$parameters" type="service" id="parameter_bag"/>
            <argument key="$translator" type="service" id="translator"/>
        </service>
        <service id="Adeliom\SyliusHappyCMSPlugin\Services\Media\MediaManager" alias="happy.cms.media.manager" public="true"/>

        <service id="happy.cms.media.helper" class="Adeliom\SyliusHappyCMSPlugin\Services\Media\MediaHelper" public="true" autowire="true">
            <argument key="$parameters" type="service" id="parameter_bag"/>
            <argument key="$em" type="service" id="doctrine.orm.entity_manager"/>
        </service>
        <service id="Adeliom\SyliusHappyCMSPlugin\Services\Media\MediaHelper" alias="happy.cms.media.helper" public="true"/>

        <service id="happy.cms.media.form.media" class="Adeliom\SyliusHappyCMSPlugin\Form\MediaType" public="true" autowire="true">
            <call method="setManager">
                <argument key="$manager" type="service" id="happy.cms.media.manager"/>
            </call>
        </service>

        <service id="happy.cms.media.twig.happy.cms.media_extension" class="Adeliom\SyliusHappyCMSPlugin\Twig\Media\MediaExtension" public="true" autowire="true">
            <argument key="$manager" type="service" id="happy.cms.media.manager"/>
            <tag name="twig.extension" />
        </service>

        <service id="happy.cms.media.twig.happy.cms.media_runtime" class="Adeliom\SyliusHappyCMSPlugin\Twig\Media\MediaRuntime" public="true" autowire="true">
            <argument key="$manager" type="service" id="happy.cms.media.manager"/>
            <argument key="$twig" type="service" id="twig"/>
            <argument key="$filterManager" type="service" id="liip_imagine.filter.manager"/>
            <tag name="twig.runtime" />
        </service>

        <service id="happy.cms.media.imagine.data.loader" class="Adeliom\SyliusHappyCMSPlugin\Services\Media\MediaDataLoader" public="true" autowire="true">
            <tag name="liip_imagine.binary.loader" loader="happy.cms.media_data_loader" />
            <argument type="service" id="happy.cms.media.storage" />
            <argument type="service" id="liip_imagine.extension_guesser" />
            <argument type="service" id="liip_imagine.binary.loader.default" />
        </service>

        <service id="happy.cms.media.event_listener.folder" class="Adeliom\SyliusHappyCMSPlugin\EventListener\Media\FolderSubscriber" public="true" autowire="true">
            <argument key="$manager" type="service" id="happy.cms.media.manager"/>
            <tag name="doctrine.event_listener" event="preUpdate"/>
        </service>

        <service id="happy.cms.media.event_listener.media" class="Adeliom\SyliusHappyCMSPlugin\EventListener\Media\MediaSubscriber" public="true" autowire="true">
            <argument key="$manager" type="service" id="happy.cms.media.manager"/>
            <tag name="doctrine.event_listener" event="preUpdate"/>
        </service>

    </services>
</container>
