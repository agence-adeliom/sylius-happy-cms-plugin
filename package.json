{
  "name": "@agence-adeliom/sylius-happy-cms-plugin",
  "version": "2.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "encore dev",
    "watch": "encore dev --watch",
    "build": "encore production",
    "lint": "eslint -c .eslintrc.cjs ./assets/js",
    "lint-style": "stylelint --fix --no-cache \"./assets/**/*.css\""
  },
  "dependencies": {
    "@agence-adeliom/sylius-happy-cms-assets": "file:./assets"
  },
  "devDependencies": {
    "@adeliom/easy-media-manager": "github:agence-adeliom/easy-media-manager",
    "@babel/preset-react": "^7.0.0",
    "@hotwired/stimulus": "^3.0.0",
    "@hotwired/stimulus-webpack-helpers": "^1.0.1",
    "@symfony/stimulus-bridge": "^4.0.0",
    "@symfony/webpack-encore": "^2.0",
    "autoprefixer": "^10.4.23",
    "buffer": "^6.0.3",
    "eslint": "^8.56.0",
    "file-loader": "^6.2.0",
    "infinite-tree": "^1.18.0",
    "postcss-loader": "^6.2.1",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resolve-url-loader": "^4.0.0",
    "sass": "^1.35.1",
    "sass-loader": "^12.1.0",
    "sortablejs": "^1.15.2",
    "stylelint": "^16.3.0",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^2.2.4"
  },
  "symfony": {
    "controllers": {
      "page-tree-tree": {
        "main": "controllers/PageTreeController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "page-tree-delete": {
        "main": "controllers/DeletePageController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "menu-item-tree-tree": {
        "main": "controllers/MenuItemTreeController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "menu-item-tree-delete": {
        "main": "controllers/DeleteMenuItemController.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      },
      "builder-block-editor": {
        "main": "controllers/BlockEditor.js",
        "webpackMode": "lazy",
        "fetch": "lazy",
        "enabled": true
      }
    }
  },
  "files": [
    "./package.json",
    "./README.md",
    "./LICENSE",
    "./assets/"
  ]
}
