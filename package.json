    "sass-loader": "^12.1.0",
    "sortablejs": "^1.15.2",
    "stylelint": "^16.3.0",
    "stylelint-config-standard": "^36.0.0",
    "vue-loader": "^15.9.7",
    "vue-template-compiler": "^2.6.14",
    "@symfony/stimulus-bridge": "^4.0.0",
    "@hotwired/stimulus-webpack-helpers": "^1.0.1",
