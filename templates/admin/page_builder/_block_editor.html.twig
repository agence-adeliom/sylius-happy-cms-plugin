<div {{ attributes.defaults(stimulus_controller('@agence-adeliom/sylius-happy-cms-plugin/builder-block-editor', {
    blockId: this.blockId
})) }}
     style="display: flex; flex-direction: column; height: 100%;">
    {% if this.hasBlock %}
        {# Edit mode: Show form for existing block #}
        <div class="page-builder__editor-content page-builder__editor-content--form" data-loading="hide">
            {# Block toolbar #}
            <div class="page-builder__block-toolbar">
                {# Left: Block name #}
                <div class="page-builder__block-toolbar-left">
                    <strong>{{ this.blockName }}</strong>
                </div>

                {# Middle: Visibility and position dropdowns #}
                <div class="page-builder__block-toolbar-middle">
                    {# Visibility dropdown #}
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                type="button"
                                id="visibilityDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            {% if this.block.isPreviewPublished %}
                                {{ ux_icon('tabler:eye', {class: 'icon'}) }}
                                {% trans %}sylius_happy_cms.page_builder.published{% endtrans %}
                            {% else %}
                                {{ ux_icon('tabler:eye-off', {class: 'icon'}) }}
                                {% trans %}sylius_happy_cms.page_builder.unpublished{% endtrans %}
                            {% endif %}
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="visibilityDropdown">
                            <li>
                                <a class="dropdown-item{% if this.block.isPreviewPublished %} active{% endif %}"
                                   href="#"
                                   data-action="live#action"
                                   data-live-action-param="prevent|togglePublished">
                                    {% trans %}sylius_happy_cms.page_builder.publish_block{% endtrans %}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item{% if not this.block.published %} active{% endif %}"
                                   href="#"
                                   data-action="live#action"
                                   data-live-action-param="prevent|togglePublished">
                                    {% trans %}sylius_happy_cms.page_builder.unpublish_block{% endtrans %}
                                </a>
                            </li>
                        </ul>
                    </div>

                    {# Position dropdown #}
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                type="button"
                                id="positionDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            {{ ux_icon('tabler:arrows-up-down', {class: 'icon'}) }}
                            {% trans with {'%position%': this.blockPosition + 1, '%total%': this.totalBlocks} %}sylius_happy_cms.page_builder.position{% endtrans %}
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="positionDropdown">
                            <li>
                                <a class="dropdown-item"
                                   href="#"
                                   data-action="live#action"
                                   data-live-action-param="prevent|moveBlock"
                                   data-live-position-param="0">
                                    {% trans %}sylius_happy_cms.page_builder.move_first{% endtrans %}
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   href="#"
                                   data-action="live#action"
                                   data-live-action-param="prevent|moveBlock"
                                   data-live-position-param="{{ this.totalBlocks - 1 }}">
                                    {% trans %}sylius_happy_cms.page_builder.move_last{% endtrans %}
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            {% for i in 0..this.totalBlocks - 1 %}
                                <li>
                                    <a class="dropdown-item{% if i == this.blockPosition %} active{% endif %}"
                                       href="#"
                                       data-action="live#action"
                                       data-live-action-param="prevent|moveBlock"
                                       data-live-position-param="{{ i }}">
                                        {% trans with {'%position%': i + 1} %}sylius_happy_cms.page_builder.move_to_position{% endtrans %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>

                {# Right: Delete/Restore button #}
                <div class="page-builder__block-toolbar-right">
                    {% if this.block.isDeleted %}
                        {# Restore button for deleted blocks #}
                        <button type="button"
                                class="btn btn-sm btn-success"
                                data-action="live#action"
                                data-live-action-param="prevent|restoreBlock">
                            {{ ux_icon('tabler:arrow-back-up', {class: 'icon'}) }}
                            {% trans %}sylius_happy_cms.page_builder.restore{% endtrans %}
                        </button>
                    {% else %}
                        {# Delete button with confirmation dropdown #}
                        <div class="dropdown">
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger dropdown-toggle"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">
                                {{ ux_icon('tabler:trash', {class: 'icon'}) }}
                                {% trans %}sylius_happy_cms.page_builder.delete{% endtrans %}
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-3 page-builder__confirm-menu">
                                <p class="mb-3 text-secondary small">
                                    {{ ux_icon('tabler:alert-triangle', {class: 'icon text-warning me-1'}) }}
                                    {% trans %}sylius_happy_cms.page_builder.confirm_delete{% endtrans %}
                                </p>
                                <button type="button"
                                        class="btn btn-danger btn-sm w-100"
                                        data-action="live#action"
                                        data-live-action-param="prevent|deleteBlock">
                                    {{ ux_icon('tabler:trash-x', {class: 'icon'}) }}
                                    {% trans %}sylius_happy_cms.page_builder.confirm_delete_action{% endtrans %}
                                </button>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Block Form Editor Iframe #}
            <iframe
                class="block-editor-form-iframe page-builder__form-iframe"
                data-page-builder-target="blockFormIframe"
                sandbox="allow-same-origin allow-scripts allow-forms allow-modals allow-popups"
                src="{{ path('sylius_happy_cms_admin_page_builder_block_edit', {
                    resource: this.resourceName,
                    id: this.entityId,
                    blockId: this.blockId,
                    locale: this.locale
                }) }}"
                title="{% trans %}sylius_happy_cms.page_builder.edit_block{% endtrans %}">
            </iframe>
        </div>

        {# Footer with save button is now handled by BlockEditorForm #}
    {% else %}
        {# Create mode: Show block selector or copy from locale option #}
        <div class="page-builder__editor-content page-builder__editor-content--empty">
            <div class="page-builder__empty-state">

                {% set hasBlocksForCurrentLocale = this.hasBlocksForCurrentLocale %}
                {% set availableLocalesWithBlocks = this.availableLocalesWithBlocks %}

                {% if not hasBlocksForCurrentLocale and availableLocalesWithBlocks|length > 0 %}
                    {# No blocks in current locale but other locales have blocks - show copy option #}
                    <div class="alert alert-info mb-4 page-builder__empty-state-alert">
                        {{ ux_icon('tabler:info-circle', {class: 'icon me-1'}) }}
                        {% trans %}sylius_happy_cms.page_builder.no_blocks_for_locale{% endtrans %}
                    </div>

                    <p class="h4 mb-4">{% trans %}sylius_happy_cms.page_builder.copy_from_locale_title{% endtrans %}</p>

                    <div class="list-group mb-4 page-builder__empty-state-narrow">
                        {% for localeCode, localeLabel in availableLocalesWithBlocks %}
                            <button
                                type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                data-action="live#action"
                                data-live-action-param="prevent|copyBlocksFromLocale"
                                data-live-source-locale-param="{{ localeCode }}"
                            >
                                <span class="d-inline-flex align-items-center gap-2">
                                    {{ ux_icon('tabler:copy-plus', {class: 'icon'}) }}
                                    {% trans with {'%locale%': localeLabel} %}sylius_happy_cms.page_builder.copy_from_locale{% endtrans %}
                                </span>
                                {{ ux_icon('tabler:chevron-right', {class: 'icon'}) }}
                            </button>
                        {% endfor %}
                    </div>

                    {# AI Translation option #}
                    <div class="form-check mb-3 page-builder__empty-state-narrow">
                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="aiTranslateBlocks"
                            data-model="aiTranslateEnabled"
                        >
                        <label class="form-check-label" for="aiTranslateBlocks">
                            {% trans %}sylius_happy_cms.page_builder.ai_translate_blocks{% endtrans %}
                        </label>
                        <div class="form-text">
                            {% trans %}sylius_happy_cms.page_builder.ai_translate_blocks_help{% endtrans %}
                            <a href="https://github.com/agence-adeliom/sylius-happy-cms-plugin/blob/2.x/docs/CONFIGURE_IA_AGENT.md" target="_blank" rel="noopener noreferrer">
                                {% trans %}sylius_happy_cms.page_builder.ai_translate_learn_more{% endtrans %}
                                {{ ux_icon('tabler:external-link', {class: 'icon'}) }}
                            </a>
                        </div>
                    </div>

                    <div class="text-center">
                        <hr class="page-builder__divider">
                        <p class="text-secondary mb-3">{% trans %}sylius_happy_cms.page_builder.or_add_new_block{% endtrans %}</p>
                    </div>
                {% endif %}

                {# Always show browse blocks button #}
                <p class="h2 mb-3">{% trans %}sylius_happy_cms.page_builder.add_content{% endtrans %}</p>

                <div class="d-flex gap-3 flex-wrap justify-content-center">
                    <button
                        type="button"
                        class="btn btn-primary btn-lg page-builder__cta"
                        data-action="live#action"
                        data-live-action-param="prevent|openBlockBrowser"
                    >
                        {{ ux_icon('tabler:blocks', {class: 'icon'}) }}
                        <span>{% trans %}sylius_happy_cms.page_builder.browse_blocks{% endtrans %}</span>
                    </button>

                    <button
                        type="button"
                        class="btn btn-primary btn-lg page-builder__cta"
                        data-action="live#action"
                        data-live-action-param="prevent|openAIGenerator"
                    >
                        {{ ux_icon('tabler:sparkles', {class: 'icon'}) }}
                        <span>{% trans %}sylius_happy_cms.page_builder.generate_ai_content{% endtrans %}</span>
                    </button>
                </div>
            </div>
        </div>

    {% endif %}

    {# Block Browser Layer #}
    {% if this.showBlockBrowser %}
        {% set filteredBlocksData = this.filteredBlocks %}
        <div class="page-builder__layer">
            {# Header #}
            <div class="page-builder__layer-header">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="m-0">
                        {% trans %}sylius_happy_cms.page_builder.browse_blocks{% endtrans %}
                    </h5>
                    <button
                        type="button"
                        class="btn-close"
                        data-action="live#action"
                        data-live-action-param="prevent|closeBlockBrowser"
                        aria-label="Close"
                    ></button>
                </div>

                {# Filter controls #}
                <div class="row">
                    <div class="col-md-6">
                        <input
                            type="text"
                            class="form-control"
                            placeholder="{% trans %}sylius_happy_cms.editor.filter{% endtrans %}"
                            data-model="blockFilterText"
                        >
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <select class="form-select" data-model="blockFilterCategory">
                            <option value="all_blocks">{% trans %}sylius_happy_cms.blocks.tabs.all_blocks{% endtrans %}</option>
                            {% for tab in filteredBlocksData.tabs %}
                                {% set tabKey = tab|replace({' ': '_'})|lower %}
                                <option value="{{ tabKey }}">{{ tab|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            {# Content #}
            <div class="page-builder__layer-body">
                {% if filteredBlocksData.blocks|length > 0 %}
                    {# Blocks grid #}
                    <div class="grid">
                        {% for type, blockData in filteredBlocksData.blocks %}
                            {% set block = blockData.block %}
                            <div class="g-col-6 g-col-sm-4 g-col-md-3">
                                <div class="card card-link h-100">
                                    {# Block icon/preview #}
                                    <div class="card-img-top d-flex align-items-center justify-content-center page-builder__card-thumb">
                                        {% if block.icon is iterable %}
                                            {% set firstIcon = block.icon|first %}
                                            {% if firstIcon starts with '<' %}
                                                {{ firstIcon|raw }}
                                            {% else %}
                                                <img src="{{ firstIcon }}" alt="{{ block.name }}" class="img-fluid">
                                            {% endif %}
                                        {% elseif block.icon is not iterable and (block.icon starts with '<span' or block.icon starts with '<i ' or block.icon starts with '<svg' or block.icon starts with '<img') %}
                                            {{ block.icon|raw }}
                                        {% elseif block.icon is defined and block.icon != '' %}
                                            {{ block.icon|raw }}
                                        {% else %}
                                            {{ ux_icon('tabler:blocks', {class: 'page-builder__card-fallback-icon'}) }}
                                        {% endif %}
                                    </div>

                                    <div class="card-body d-flex flex-column">
                                        <h6 class="card-title">{{ block.name|trans }}</h6>
                                        <div class="mt-auto">
                                            <button
                                                type="button"
                                                class="btn btn-outline-primary btn-md w-100"
                                                data-action="live#action"
                                                data-live-action-param="prevent|addBlock"
                                                data-live-block-type-param="{{ type }}"
                                            >
                                                {{ ux_icon('tabler:plus', {class: 'icon'}) }}
                                                {% trans %}sylius_happy_cms.editor.add{% endtrans %}
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    {# No results message #}
                    <div class="alert alert-info" role="alert">
                        {% trans %}sylius_happy_cms.page_builder.no_blocks_found{% endtrans %}
                    </div>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {# AI Content Generator Layer #}
    {% if this.showAIGenerator %}
        <div class="page-builder__layer page-builder__layer--ai">
            {# Header #}
            <div class="page-builder__layer-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="m-0 d-flex align-items-center gap-2">
                        {{ ux_icon('tabler:sparkles', {class: 'icon'}) }}
                        {% trans %}sylius_happy_cms.page_builder.generate_ai_content{% endtrans %}
                    </h5>
                    <button
                        type="button"
                        class="btn-close"
                        data-action="live#action"
                        data-live-action-param="prevent|closeAIGenerator"
                        aria-label="Close"
                    ></button>
                </div>
            </div>

            {# Content #}
            <div class="page-builder__layer-body page-builder__layer-body--roomy">
                <div class="page-builder__layer-container">
                    {% if this.isAIGenerationAvailable %}
                        <div data-loading="action(generateAIContent)|show">
                            {% trans %}sylius_happy_cms.page_builder.ai_loading{% endtrans %}
                            <br />
                            <span class="spinner-border spinner-border-sm text-secondary mt-2" role="status"></span>
                        </div>
                        <div data-loading="action(generateAIContent)|hide">
                            {% if this.errorMessage %}
                                <div class="alert alert-danger mb-4">
                                    {{ ux_icon('tabler:exclamation-circle', {class: 'icon me-1'}) }}
                                    {{ this.errorMessage }}</div>
                            {% endif %}
                            {# AI Generation Form #}
                            <div class="alert alert-info mb-4">
                                {{ ux_icon('tabler:info-circle', {class: 'icon me-1'}) }}
                                {% trans %}sylius_happy_cms.page_builder.ai_generator_description{% endtrans %}
                            </div>

                            <div class="mb-4">
                                <label for="aiPrompt" class="form-label fw-bold">
                                    {% trans %}sylius_happy_cms.page_builder.ai_prompt_label{% endtrans %}
                                </label>
                                <textarea
                                    id="aiPrompt"
                                    class="form-control"
                                    rows="6"
                                    data-model="aiPrompt"
                                    placeholder="{% trans %}sylius_happy_cms.page_builder.ai_prompt_placeholder{% endtrans %}"
                                ></textarea>
                                <div class="form-text">
                                    {% trans %}sylius_happy_cms.page_builder.ai_prompt_help{% endtrans %}
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="aiBlockCount" class="form-label fw-bold">
                                    {% trans %}sylius_happy_cms.page_builder.ai_block_count_label{% endtrans %}
                                </label>
                                <input
                                    type="number"
                                    id="aiBlockCount"
                                    class="form-control page-builder__input-narrow"
                                    min="1"
                                    max="10"
                                    data-model="aiBlockCount"
                                >
                                <div class="form-text">
                                    {% trans %}sylius_happy_cms.page_builder.ai_block_count_help{% endtrans %}
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button
                                    type="button"
                                    class="btn btn-primary"
                                    data-action="live#action"
                                    data-live-action-param="prevent|generateAIContent"
                                >
                                    {{ ux_icon('tabler:wand', {class: 'icon'}) }}
                                    {% trans %}sylius_happy_cms.page_builder.generate_button{% endtrans %}
                                </button>
                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    data-action="live#action"
                                    data-live-action-param="prevent|closeAIGenerator"
                                >
                                    {% trans %}sylius_happy_cms.page_builder.cancel{% endtrans %}
                                </button>
                            </div>
                        </div>
                    {% else %}
                        {# AI Bundle not installed message #}
                        <div class="alert alert-warning">
                            <h6 class="alert-heading d-flex align-items-center gap-2">
                                {{ ux_icon('tabler:alert-triangle', {class: 'icon'}) }}
                                {% trans %}sylius_happy_cms.page_builder.ai_not_configured{% endtrans %}
                            </h6>
                            <p class="mb-2">{% trans %}sylius_happy_cms.page_builder.ai_not_configured_description{% endtrans %}</p>
                            <hr>
                            <p class="mb-0">
                                <a href="https://github.com/agence-adeliom/sylius-happy-cms-plugin/blob/2.x/docs/CONFIGURE_IA_AGENT.md" target="_blank" rel="noopener noreferrer" class="alert-link">
                                    {% trans %}sylius_happy_cms.page_builder.ai_learn_more{% endtrans %}
                                    {{ ux_icon('tabler:external-link', {class: 'icon ms-1'}) }}
                                </a>
                            </p>
                        </div>

                        <div class="mt-4">
                            <button
                                type="button"
                                class="btn btn-outline-secondary btn-lg"
                                data-action="live#action"
                                data-live-action-param="prevent|closeAIGenerator"
                            >
                                {% trans %}sylius_happy_cms.page_builder.close{% endtrans %}
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
