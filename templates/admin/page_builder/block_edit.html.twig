{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% form_theme form with formThemes %}

{% block page_title %}{% trans %}sylius_happy_cms.page_builder.edit_block{% endtrans %}{% endblock %}

{% block body %}
    {{ form_start(form) }}
        <div class="page-builder-form">

            {# Actions bar with save button #}
            <div class="page-builder-form__actions">
                <button type="submit" class="btn btn-primary btn-sm">
                    {{ ux_icon('tabler:device-floppy', {class: 'icon'}) }}
                    {% trans %}sylius_happy_cms.page_builder.save_block{% endtrans %}
                </button>
            </div>

            {# Form section with title #}
            <div class="page-builder-form__content">
                <h5 class="mb-3">{% trans %}sylius_happy_cms.page_builder.edit_block_title{% endtrans %}</h5>

                {% include '@SyliusAdmin/shared/crud/common/content/flashes.html.twig' %}

                {{ form_widget(form) }}
            </div>

        </div>
    {{ form_end(form) }}

    {% if sendMessageToParent %}
        <script>
            // Notify parent window that the block was saved
            if (window.parent !== window) {
                window.parent.postMessage({
                    type: 'block:saved',
                    blockId: {{ blockId }}
                }, '*');
            }
        </script>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('page-builder.css', 'sylius.happy.cms.assets.package') }}">

    {# Inject block-specific CSS assets #}
    {% if blockAssets is defined %}
        {% for cssAsset in blockAssets.css %}
            {% if cssAsset.getPackageName is defined %}
                <link rel="stylesheet" href="{{ asset(cssAsset.value, cssAsset.getPackageName) }}">
            {% else %}
                <link rel="stylesheet" href="{{ asset(cssAsset) }}">
            {% endif %}
        {% endfor %}

        {# Inject block-specific Webpack Encore assets (CSS) #}
        {% for webpackAsset in blockAssets.webpack %}
            {% if webpackAsset.getWebpackPackageName is defined %}
                {{ encore_entry_link_tags(webpackAsset.value, webpackAsset.getWebpackPackageName) }}
            {% else %}
                {{ encore_entry_link_tags(webpackAsset) }}
            {% endif %}
        {% endfor %}
    {% endif %}

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    {# Inject block-specific JS assets #}
    {% if blockAssets is defined %}
        {% for jsAsset in blockAssets.js %}
            {% if jsAsset.getPackageName is defined %}
                <script src="{{ asset(jsAsset.value, jsAsset.getPackageName) }}"></script>
            {% else %}
                <script src="{{ asset(jsAsset) }}"></script>
            {% endif %}
        {% endfor %}

        {# Inject block-specific Webpack Encore assets (JS) #}
        {% for webpackAsset in blockAssets.webpack %}
            {% if webpackAsset.getWebpackPackageName is defined %}
                {{ encore_entry_script_tags(webpackAsset.value, webpackAsset.getWebpackPackageName) }}
            {% else %}
                {{ encore_entry_script_tags(webpackAsset) }}
            {% endif %}
        {% endfor %}
    {% endif %}

    <script type="text/javascript">
        document.addEventListener('DOMContentLoaded', function() {
            // Remove Symfony toolbar inside iframe
            if (document.querySelector('.sf-toolbar')) {
                document.querySelector('.sf-toolbar').remove();
            }
        });
    </script>
{% endblock %}
