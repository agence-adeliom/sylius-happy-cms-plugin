{% set entity = hookable_metadata.context.entity %}
{% set resource = hookable_metadata.context.resource %}
{% set contentBlocks = hookable_metadata.context.contentBlocks %}
{% set currentLocale = hookable_metadata.context.locale %}
{% set availableLocales = hookable_metadata.context.availableLocales %}

<div class="page-wrapper page-builder" data-controller="page-builder">
    {# Toolbar #}
    <div class="page-builder__toolbar">
        <div class="page-builder__toolbar-section">
            <a href="#" class="btn btn-sm btn-outline-secondary btn-toolbar text-truncate">
                ← {{ entity|default('') }}
            </a>
        </div>

        <div class="page-builder__toolbar-section">
            {# Resolution selector #}
            <div class="resolution-selector" data-page-builder-target="resolutionSelector">
                <button type="button" class="active" data-resolution="desktop">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M0 3a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3zm2-1a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H2zM5.5 14a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5z"/>
                    </svg>
                </button>
                <button type="button" data-resolution="tablet">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M12 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h8zM4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4z"/>
                        <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                    </svg>
                </button>
                <button type="button" data-resolution="mobile">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                        <path d="M11 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h6zM5 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H5z"/>
                        <path d="M8 14a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
                    </svg>
                </button>
            </div>
        </div>

        <div class="page-builder__toolbar-section">
            {# TODO: Open in new tab link to published page #}
            <a href="#" class="btn btn-sm btn-outline-secondary btn-toolbar" target="_blank" title="{% trans %}sylius_happy_cms.page_builder.view_published{% endtrans %}">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/>
                    <path d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/>
                </svg>
            </a>

            <span class="text-muted">|</span>

            {# Locale selector dropdown #}
            {% from '@SyliusShop/shared/macro/locales.html.twig' import locale %}
            <div class="dropdown">
                <button class="btn btn-sm btn-toolbar btn-outline-secondary dropdown-toggle"
                        type="button"
                        id="localeDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        data-current-locale="{{ locale(currentLocale) }}">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" style="margin-right: 4px;">
                        <path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.5-6.923c-.67.204-1.335.82-1.887 1.855A7.97 7.97 0 0 0 5.145 4H7.5V1.077zM4.09 4a9.267 9.267 0 0 1 .64-1.539 6.7 6.7 0 0 1 .597-.933A7.025 7.025 0 0 0 2.255 4H4.09zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a6.958 6.958 0 0 0-.656 2.5h2.49zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5H4.847zM8.5 5v2.5h2.99a12.495 12.495 0 0 0-.337-2.5H8.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5H4.51zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5H8.5zM5.145 12c.138.386.295.744.468 1.068.552 1.035 1.218 1.65 1.887 1.855V12H5.145zm.182 2.472a6.696 6.696 0 0 1-.597-.933A9.268 9.268 0 0 1 4.09 12H2.255a7.024 7.024 0 0 0 3.072 2.472zM3.82 11a13.652 13.652 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5H3.82zm6.853 3.472A7.024 7.024 0 0 0 13.745 12H11.91a9.27 9.27 0 0 1-.64 1.539 6.688 6.688 0 0 1-.597.933zM8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855.173-.324.33-.682.468-1.068H8.5zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.65 13.65 0 0 1-.312 2.5zm2.802-3.5a6.959 6.959 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5h2.49zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7.024 7.024 0 0 0-3.072-2.472c.218.284.418.598.597.933zM10.855 4a7.966 7.966 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4h2.355z"/>
                    </svg>
                    {{ locale(currentLocale) }}
                </button>
                <ul class="dropdown-menu" aria-labelledby="localeDropdown">
                    {% for availableLocale in availableLocales %}
                        <li>
                            <a class="dropdown-item{% if availableLocale == currentLocale %} active{% endif %}"
                               href="#"
                               data-locale="{{ availableLocale }}">
                                {{ locale(availableLocale) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <span class="text-muted">|</span>

            {# Save button #}
{#            <button type="button" class="btn btn-sm btn-outline-primary btn-toolbar">#}
{#                {% trans %}sylius_happy_cms.page_builder.save_draft{% endtrans %}#}
{#            </button>#}

            {# Publish button #}
            <button type="button" class="btn btn-sm btn-primary btn-toolbar">
                {% trans %}sylius_happy_cms.page_builder.publish{% endtrans %}
            </button>
        </div>
    </div>

    {# Main content with sidebar and preview #}
    <div class="page-builder__content">
        {# Sidebar #}
        <div class="page-builder__sidebar" data-page-builder-target="sidebar">
            <div class="page-builder__sidebar-inner">
                {# Add block button #}
                <button type="button" data-page-builder-target="addBlock" class="page-builder__add-block" title="{% trans %}sylius_happy_cms.page_builder.add_block{% endtrans %}">
                    +
                </button>

                {# Block handles - dynamically generated from contentBlocks #}
                <div class="page-builder__block-handles" data-page-builder-target="blockHandles">
                    {% for contentBlock in contentBlocks %}
                        <div class="page-builder__block-handle{% if not contentBlock.published %} is-unpublished{% endif %}"
                             data-block-id="{{ contentBlock.id }}"
                             data-block-type="{{ contentBlock.type }}"
                             data-block-layer="{{ contentBlock.layer|default('default') }}"
                             data-published="{{ contentBlock.published ? 'true' : 'false' }}"
                        >
                            <button type="button"
                                    class="page-builder__block-handle-button"
                                    title="Edit block{% if not contentBlock.published %} (Unpublished){% endif %}">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M7 2a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zM7 5a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zM7 8a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-3 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm-3 3a1 1 0 1 1-2 0 1 1 0 0 1 2 0zm3 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0z"/>
                                </svg>
                            </button>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Preview iframe #}
        <div class="page-builder__preview" data-page-builder-target="preview">
            <div class="page-builder__preview-inner">
                <div class="page-builder__iframe-wrapper resolution-desktop" data-page-builder-target="iframeWrapper">
                    <iframe
                        class="page-builder__iframe"
                        data-page-builder-target="iframe"
                        data-BlockEditor-target="iframe"
                        sandbox="allow-same-origin allow-scripts allow-forms"
                        src="about:blank"
                        title="{% trans %}sylius_happy_cms.page_builder.preview{% endtrans %}">
                    </iframe>
                </div>
            </div>
        </div>

        {# Right panel - Block editor #}
        <div class="page-builder__editor-panel" data-page-builder-target="editorPanel">
            {# Header with controls #}
            <div class="page-builder__editor-header">
                <a href="#" type="button"
                        class="page-builder__editor-toggle icon-link"
                        data-page-builder-target="editorToggle"
                        title="{% trans %}sylius_happy_cms.page_builder.toggle_panel{% endtrans %}">
                    {% trans %}sylius_happy_cms.page_builder.close_panel{% endtrans %}
                    <svg width="16" height="16" style="margin-left: 4px" class="bi" viewBox="0 0 16 16" fill="currentColor">
                        <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                    </svg>

                </a>

{#                <button type="button"#}
{#                        class="page-builder__editor-menu"#}
{#                        title="{% trans %}sylius_happy_cms.page_builder.menu{% endtrans %}">#}
{#                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">#}
{#                        <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>#}
{#                    </svg>#}
{#                </button>#}
            </div>

            {# Live Component for block editing #}
            <div data-page-builder-target="editorContent">
                {{ component('happycms-builder-block-editor', {
                    resourceName: resource,
                    entityId: entity.id,
                }) }}
            </div>
        </div>
    </div>
</div>
