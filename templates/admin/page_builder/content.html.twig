{% set entity = hookable_metadata.context.entity %}
{% set resource = hookable_metadata.context.resource %}
{% set contentBlocks = hookable_metadata.context.contentBlocks %}
{% set currentLocale = hookable_metadata.context.locale %}
{% set availableLocales = hookable_metadata.context.availableLocales %}
{% set backRoute = hookable_metadata.context.backRoute|default(null) %}

<div class="page-wrapper page-builder" data-controller="page-builder">
    {# Toolbar #}
    <div class="page-builder__toolbar">
        <div class="page-builder__toolbar-section page-builder__toolbar-section--back">
            <a href="{{ backRoute ? path(backRoute, {'id': entity.id}) : '' }}" class="btn btn-sm btn-outline-secondary text-truncate" title="{% trans %}sylius_happy_cms.page_builder.back{% endtrans %}">
                {{ ux_icon('tabler:arrow-left', {class: 'icon'}) }}
                <span>{{ entity|default('Back') }}</span>
            </a>
        </div>

        <div class="page-builder__toolbar-section page-builder__toolbar-section--resolution">
            {# Resolution selector #}
            <div class="btn-group resolution-selector" role="group" data-page-builder-target="resolutionSelector">
                <button type="button" class="btn btn-sm btn-outline-secondary btn-icon active" data-resolution="desktop">
                    {{ ux_icon('tabler:device-desktop', {class: 'icon'}) }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-resolution="tablet">
                    {{ ux_icon('tabler:device-tablet', {class: 'icon'}) }}
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" data-resolution="mobile">
                    {{ ux_icon('tabler:device-mobile', {class: 'icon'}) }}
                </button>
            </div>

            {# Alignment selector #}
            <button type="button"
                    class="btn btn-sm btn-icon btn-outline-secondary"
                    data-page-builder-target="alignmentToggle"
                    title="{% trans %}sylius_happy_cms.page_builder.toggle_alignment{% endtrans %}">
                {{ ux_icon('tabler:layout-align-center', {class: 'icon'}) }}
            </button>
        </div>

        <div class="page-builder__toolbar-section">
            <a href="{{ happy_cms_path_by_id(entity.id, resource, currentLocale) }}" class="btn btn-sm btn-icon btn-outline-secondary" target="_blank" title="{% trans %}sylius_happy_cms.page_builder.view_published{% endtrans %}">
                {{ ux_icon('tabler:external-link', {class: 'icon'}) }}
            </a>

            {# Locale selector dropdown #}
            {% from '@SyliusShop/shared/macro/locales.html.twig' import locale %}
            <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                        type="button"
                        id="localeDropdown"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                        data-current-locale="{{ locale(currentLocale) }}">
                    {{ ux_icon('tabler:world', {class: 'icon'}) }}
                    {{ locale(currentLocale) }}
                </button>
                <ul class="dropdown-menu" aria-labelledby="localeDropdown">
                    {% for availableLocale in availableLocales %}
                        <li>
                            <a class="dropdown-item{% if availableLocale == currentLocale %} active{% endif %}"
                               href="#"
                               data-locale="{{ availableLocale }}">
                                {{ locale(availableLocale) }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#publishModal">
                {{ ux_icon('tabler:check', {class: 'icon'}) }}
                {% trans %}sylius_happy_cms.page_builder.publish{% endtrans %}
            </button>
        </div>
    </div>

    {# Publish Modal #}
    <div class="modal fade" id="publishModal" tabindex="-1" aria-labelledby="publishModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="publishModalLabel">{% trans %}sylius_happy_cms.page_builder.publish_title{% endtrans %}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>{% trans %}sylius_happy_cms.page_builder.publish_description{% endtrans %}</p>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="selectAllLocales" checked>
                        <label class="form-check-label fw-bold" for="selectAllLocales">
                            {% trans %}sylius_happy_cms.page_builder.select_all_locales{% endtrans %}
                        </label>
                    </div>
                    <hr class="my-3">
                    {% for availableLocale in availableLocales %}
                        <div class="form-check">
                            <input class="form-check-input locale-checkbox" type="checkbox" value="{{ availableLocale }}" id="locale_{{ availableLocale }}" name="locales[]" checked>
                            <label class="form-check-label" for="locale_{{ availableLocale }}">
                                {{ locale(availableLocale) }}
                            </label>
                        </div>
                    {% endfor %}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}sylius_happy_cms.page_builder.cancel{% endtrans %}</button>
                    <button type="button" class="btn btn-primary" id="confirmPublishBtn">
                        {% trans %}sylius_happy_cms.page_builder.confirm_publish{% endtrans %}
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Main content with sidebar and preview #}
    <div class="page-builder__content">
        {# Sidebar #}
        <div class="page-builder__sidebar" data-page-builder-target="sidebar">
            <div class="page-builder__sidebar-inner">
                {# Add block button #}
                <button type="button" data-page-builder-target="addBlock" class="page-builder__add-block" title="{% trans %}sylius_happy_cms.page_builder.add_block{% endtrans %}">
                    {{ ux_icon('tabler:plus', {class: 'icon'}) }}
                </button>

                {# Block handles - dynamically generated from contentBlocks #}
                <div class="page-builder__block-handles" data-page-builder-target="blockHandles">
                    {% for contentBlock in contentBlocks %}
                        <div class="page-builder__block-handle{% if contentBlock.deleted %} is-deleted{% elseif not contentBlock.published %} is-unpublished{% endif %}"
                             data-block-id="{{ contentBlock.id }}"
                             data-block-type="{{ contentBlock.type }}"
                             data-block-layer="{{ contentBlock.layer|default('default') }}"
                             data-published="{{ contentBlock.published ? 'true' : 'false' }}"
                             data-deleted="{{ contentBlock.deleted ? 'true' : 'false' }}"
                        >
                            <button type="button"
                                    class="page-builder__block-handle-button"
                                    title="{% if contentBlock.deleted %}Restore block (Deleted){% elseif not contentBlock.published %}Edit block (Unpublished){% else %}Edit block{% endif %}">
                                {% if contentBlock.deleted %}
                                    {{ ux_icon('tabler:arrow-back-up', {class: 'icon'}) }}
                                {% else %}
                                    {{ ux_icon('tabler:pencil', {class: 'icon'}) }}
                                {% endif %}
                            </button>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Preview iframe #}
        <div class="page-builder__preview" data-page-builder-target="preview">
            <div class="page-builder__preview-inner">
                <div class="page-builder__iframe-wrapper resolution-desktop" data-page-builder-target="iframeWrapper">
                    <iframe
                        class="page-builder__iframe"
                        data-page-builder-target="iframe"
                        data-BlockEditor-target="iframe"
                        sandbox="allow-same-origin allow-scripts allow-forms"
                        src="about:blank"
                        title="{% trans %}sylius_happy_cms.page_builder.preview{% endtrans %}">
                    </iframe>
                </div>
            </div>
        </div>

        {# Right panel - Block editor #}
        <div class="page-builder__editor-panel" data-page-builder-target="editorPanel">
            {# Header with controls #}
            <div class="page-builder__editor-header">
                <button type="button"
                        class="page-builder__editor-toggle btn btn-sm btn-ghost-secondary"
                        data-page-builder-target="editorToggle"
                        title="{% trans %}sylius_happy_cms.page_builder.toggle_panel{% endtrans %}">
                    {% trans %}sylius_happy_cms.page_builder.close_panel{% endtrans %}
                    {{ ux_icon('tabler:arrow-right', {class: 'icon ms-1 me-0'}) }}
                </button>
            </div>

            {# Live Component for block editing #}
            <div data-page-builder-target="editorContent" class="w-editor-content">
                {{ component('happycms-builder-block-editor', {
                    resourceName: resource,
                    entityId: entity.id,
                    locale: currentLocale,
                }) }}
            </div>
        </div>
    </div>
</div>
