{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% trans_default_domain 'SyliusHappyCMSPlugin' %}

{% block page_title %}{% trans %}sylius_happy_cms.page_builder.title{% endtrans %} - {{ entity.name|default('Page') }}{% endblock %}

{% block body %}
    {% hook 'sylius_admin.happy_cms.page_builder' %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('page-builder.css', 'sylius.happy.cms.assets.package') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <div data-builder-configuration
         data-iframe-url="{{ happy_cms_path_by_id(entity.id, resource, locale, null, true) }}"
         data-select-locale-message="{{ 'sylius_happy_cms.page_builder.select_at_least_one_locale'|trans|raw }}"
         style="display:none;">
    </div>
    <script src="{{ asset('page-builder.js', 'sylius.happy.cms.assets.package') }}"></script>
{% endblock %}
