{% block happy_cms_tinymce_widget %}
    <tinymce-editor
            id="{{ id }}"
            name="{{ full_name }}"
            {{ required ? "required" : "" }}
            {% with { attr: tinymce_attributes(attr) } %}
                {{ block('attributes') }}
            {% endwith %}
            src="/bundles/tinymce/ext/tinymce/tinymce.min.js"
    >{{ value }}</tinymce-editor>
    {% include '@Tinymce/partial/default_tinymce_config.html.twig' %}
    {# The tinymce-webcomponent.js script is now loaded by assets/tinymce/field.js to handle AJAX/Live components #}
    <noscript>
		<textarea id="{{ id }}-noscript"
                  name="{{ full_name }}"
			{{ required ? "required" : "" }}
                {% with { attr: tinymce_attributes(attr) } %}
                    {{ block('attributes') }}
                {% endwith %}>{{ value }}</textarea>
    </noscript>
{% endblock %}

{% block happy_cms_tinymce_row %}
    <div class="field mb-3">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
    </div>
{% endblock %}
