{% set title = settings.title|default(false) %}
{% set wysiwyg = settings.wysiwyg|default(false) %}
{% set cta = settings.cta|default(false) %}
{% set items = settings.items|default([]) %}
{% set accordion_id = 'accordion-' ~ random() %}

{% if title or wysiwyg or cta or items is not empty %}
<section class="py-6">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-md-5">
                {% if title %}
                    <h2 class="h3 mb-3">{{ title }}</h2>
                {% endif %}
                {% if wysiwyg %}
                    <div class="mb-4">
                        {{ wysiwyg|raw }}
                    </div>
                {% endif %}
                {% if cta is iterable and cta.link and cta.label %}
                    <a href="{{ cta.link }}" class="btn btn-primary">{{ cta.label }}</a>
                {% endif %}
            </div>
            {% if items is not empty %}
                <div class="col-12 col-md-7">
                    <div class="accordion" id="{{ accordion_id }}">
                        {% for index, item in items %}
                            {% set item_title = item.title|default(false) %}
                            {% set item_content = item.content|default(false) %}
                            {% set item_id = accordion_id ~ '-item-' ~ index %}
                            <div class="accordion-item">
                                <h3 class="accordion-header">
                                    <button class="accordion-button{% if index != 0 %} collapsed{% endif %}"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#{{ item_id }}"
                                            aria-expanded="{% if index == 0 %}true{% else %}false{% endif %}"
                                            aria-controls="{{ item_id }}">
                                        {{ item_title }}
                                    </button>
                                </h3>
                                <div id="{{ item_id }}"
                                     class="accordion-collapse collapse{% if index == 0 %} show{% endif %}"
                                     data-bs-parent="#{{ accordion_id }}">
                                    <div class="accordion-body">
                                        {{ item_content|raw }}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
