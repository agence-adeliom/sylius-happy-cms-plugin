{% set title = settings.title|default(false) %}
{% set wysiwyg = settings.wysiwyg|default(false) %}
{% set cta_one = settings.cta_one|default(false) %}
{% set cta_two = settings.cta_two|default(false) %}

{% if title or wysiwyg or cta_one or cta_two %}
<section class="py-6 bg-light">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-lg-8">
                {% if title %}
                    <h2 class="h4 mb-3">{{ title }}</h2>
                {% endif %}
                {% if wysiwyg %}
                    <div>
                        {{ wysiwyg|raw }}
                    </div>
                {% endif %}
            </div>
            {% if (cta_one is iterable and cta_one.link and cta_one.label) or (cta_two is iterable and cta_two.link and cta_two.label) %}
                <div class="col-12 col-lg-4 text-lg-end">
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        {% if cta_one is iterable and cta_one.link and cta_one.label %}
                            <a href="{{ cta_one.link }}" class="btn btn-primary">{{ cta_one.label }}</a>
                        {% endif %}
                        {% if cta_two is iterable and cta_two.link and cta_two.label %}
                            <a href="{{ cta_two.link }}" class="btn btn-outline-secondary">{{ cta_two.label }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
