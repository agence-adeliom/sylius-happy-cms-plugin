{% set title = settings.title|default(false) %}
{% set wysiwyg = settings.wysiwyg|default(false) %}
{% set images = settings.images|default([]) %}

{% if title or wysiwyg or images is not empty %}
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-8 offset-lg-2 text-center mb-4">
                {% if title %}
                    <h2 class="h3 mb-3">{{ title }}</h2>
                {% endif %}
                {% if wysiwyg %}
                    <div class="mb-4">
                        {{ wysiwyg|raw }}
                    </div>
                {% endif %}
            </div>
        </div>
        {% if images is not empty %}
            <div class="row g-3 g-lg-4">
                {% for img in images %}
                    {% if img %}
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="ratio ratio-4x3 rounded overflow-hidden shadow-sm">
                                {{ happy_cms_media(img, 'reference', {
                                    'class': 'object-fit-cover w-100 h-100',
                                    'alt': title|default('sylius.homepage.banner_content'|trans)
                                }) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
{% endif %}
