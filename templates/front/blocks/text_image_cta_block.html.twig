{% set img_right = settings.img_right|default(false) %}
{% set img = settings.image|default(false) %}
{% set headline = settings.headline|default(false) %}
{% set title = settings.title|default(false) %}
{% set wysiwyg = settings.wysiwyg|default(false) %}
{% set cta_one = settings.cta_one|default(false) %}
{% set cta_two = settings.cta_two|default(false) %}

{% if img_right or img or headline or title or wysiwyg or cta_one or cta_two %}
<section class="py-6">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-center">
            <div class="col-12 col-lg-6{% if img_right %} order-lg-2{% endif %}">
                {% if img %}
                    <div class="ratio ratio-16x9 rounded overflow-hidden shadow">
                        {{ happy_cms_media(img, 'reference', {
                            'class': 'object-fit-cover w-100 h-100',
                            'alt': title|default('sylius.homepage.banner_content'|trans)
                        }) }}
                    </div>
                {% endif %}
            </div>
            <div class="col-12 col-lg-6{% if img_right %} order-lg-1{% endif %}">
                {% if headline %}
                    <p class="text-primary text-uppercase fw-semibold mb-2 small">{{ headline }}</p>
                {% endif %}
                {% if title %}
                    <h2 class="display-6 fw-bold mb-3">{{ title|raw }}</h2>
                {% endif %}
                {% if wysiwyg %}
                    <div class="mb-4 fs-6">
                        {{ wysiwyg|raw }}
                    </div>
                {% endif %}
                {% if (cta_one is iterable and cta_one.link and cta_one.label) or (cta_two is iterable and cta_two.link and cta_two.label) %}
                    <div class="d-flex flex-wrap gap-2">
                        {% if cta_one is iterable and cta_one.link and cta_one.label %}
                            <a href="{{ cta_one.link }}" class="btn btn-primary">{{ cta_one.label }}</a>
                        {% endif %}
                        {% if cta_two is iterable and cta_two.link and cta_two.label %}
                            <a href="{{ cta_two.link }}" class="btn btn-outline-secondary">{{ cta_two.label }}</a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endif %}
