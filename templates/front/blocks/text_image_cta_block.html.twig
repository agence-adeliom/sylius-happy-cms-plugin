{% set img_right = settings.img_right|default(false) %}
{% set img = settings.image|default(false) %}
{% set headline = settings.headline|default(false) %}
{% set title = settings.title|default(false) %}
{% set wysiwyg = settings.wysiwyg|default(false) %}
{% set cta_one = settings.cta_one|default(false) %}
{% set cta_two = settings.cta_two|default(false) %}

{% if img_right or img or headline or title or wysiwyg or cta_one or cta_two %}
<section class="container">
    <div class="wrapper-12 my-10 lg:my-20 items-center">
        <div class="col-span-full md:col-span-5 {{ img_right ? 'md:col-start-7' }}">
            {% if img %}
                {{ happy_cms_media(img, 'reference', {
                    'class': 'object-cover w-full h-full',
                    'alt': 'sylius.homepage.banner_content'|trans
                }) }}
            {% endif %}
        </div>
        <div class="col-span-full md:col-span-6 {{ img_right ? 'order-first' : 'md:col-start-7' }}">
            {% if headline %}<p class="headline">{{ headline }}</p>{% endif %}
            {% if title %}<h2 class="text-3xl md:text-4xl font-bold">{{ title|raw }}</h2>{% endif %}
            {% if wysiwyg %}
                <div class="wysiwyg mt-4 mb-6">
                    {{ wysiwyg|raw }}
                </div>
            {% endif %}
            {% if cta_one is iterable and cta_one.link and cta_one.label %}
                <a href="{{ cta_one.link }}" class="btn btn-primary">{{ cta_one.label }}</a>
            {% endif %}
            {% if cta_two is iterable and cta_two.link and cta_two.label %}
                <a href="{{ cta_two.link }}" class="btn btn-secondary">{{ cta_two.label }}</a>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
