{% if data is not empty %}
<nav id="happy_cms_seo-breadcrumbs" style="--bs-breadcrumb-divider: '{{ happy_cms_seo.breadcrumb.separator }}';" aria-label="breadcrumb">
    <ol itemscope itemtype="https://schema.org/BreadcrumbList" class="{{ happy_cms_seo.breadcrumb.class }}">
    {% for breadcrumb in data %}
        <li itemprop="itemListElement" class="{{ happy_cms_seo.breadcrumb.item_class }} {{ loop.last ? happy_cms_seo.breadcrumb.current_class : '' }} {{ loop.first ? 'item-first' : '' }}" {% if loop.last %}aria-current="page"{% endif %}  itemscope itemtype="https://schema.org/ListItem">
            <meta itemprop="position" content="{{ loop.index }}" />
            {% if loop.last or not breadcrumb.target|default(false) %}
            <span class="{{ happy_cms_seo.breadcrumb.link_class }}">
                <span itemprop="name">{{ breadcrumb.linkName|trans }}</span>
            </span>
            {% else %}
            {# "//" is collapsed in a relative first link only: an absolute URL (https://…) keeps its scheme #}
            <a itemprop="item" href="{{ loop.first and '://' not in breadcrumb.target ? breadcrumb.target|replace({'//': '/'}) : breadcrumb.target }}" class="{{ happy_cms_seo.breadcrumb.link_class }}">
                <span itemprop="name">{{ breadcrumb.linkName|trans }}</span>
            </a>
            {% endif %}
            {% if not loop.last %}
                <i class="fa-solid text-sm fa-sharp fa-chevron-right"></i>
            {% endif %}
        </li>
    {% endfor %}
    </ol>
</nav>
{% endif %}
