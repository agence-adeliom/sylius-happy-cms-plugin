{% block happy_cms_media_row %}
    <div class="field">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
    </div>
{% endblock %}

{% block happy_cms_media_widget %}
    {% set pick_options = {
        restrictions: {
            path: form.vars.restrict.path|default(null),
            uploadTypes: form.vars.restrict.uploadTypes|default(null),
            uploadSize: form.vars.restrict.uploadSize|default(null),
        },
        enableEditor:        form.vars.editor|default(true),
        enableUpload:        form.vars.upload|default(true),
        enableMove:          form.vars.move|default(true),
        enableRename:        form.vars.rename|default(true),
        enableMetas:         form.vars.metas|default(true),
        enableDelete:        form.vars.delete|default(true),
        enableBulkSelection: form.vars.bulk_selection|default(true),
    } %}

    <div class="form-widget happy-cms-media-widget"
         data-widget="{{ form.vars.id }}"
         data-pick-options="{{ pick_options|json_encode }}">

        <div class="selection-preview mb-3 js-media-preview">
            <div class="__box-data">
                <div class="__box-preview">
                    <div class="__box-img"></div>
                </div>
                <div class="__box-info">
                    <h4 class="js-media-name">{{ 'sylius_happy_cms.media.no_val'|trans({}, 'SyliusHappyCMSPlugin') }}</h4>
                    <small class="__info-file-size js-media-size" style="display:none"></small>
                </div>
                <div class="__box-update">
                    <span class="ui red button js-media-pick">
                        {{ 'sylius_happy_cms.media.select.file'|trans({}, 'SyliusHappyCMSPlugin') }}
                    </span>
                </div>
                <div class="__box-delete js-media-delete" style="display:none">
                    <span class="ui red button js-media-clear">
                        {{ 'sylius_happy_cms.media.remove'|trans({}, 'SyliusHappyCMSPlugin') }}
                    </span>
                </div>
            </div>
        </div>

        {{ form_widget(form, {type: 'number', attr: {style: 'display:none', class: 'js-media-input'}}) }}

        {% if ea.field.help ?? false %}
            <small>{{ ea.field.help|raw }}</small>
        {% elseif form.vars.help ?? false %}
            <small>{{ form.vars.help|trans(form.vars.help_translation_parameters, form.vars.translation_domain)|raw }}</small>
        {% endif %}

        {{- form_errors(form) -}}
    </div>

    <script>
    (function () {
        var widgetId = '{{ form.vars.id }}';

        function formatFileSize(bytes) {
            if (bytes === null || bytes === undefined || isNaN(bytes)) return '';
            if (bytes === 0) return '0 B';
            var units = ['B', 'KB', 'MB', 'GB', 'TB'];
            var i = Math.floor(Math.log(bytes) / Math.log(1024));
            return (bytes / Math.pow(1024, i)).toFixed(2) + ' ' + units[i];
        }

        function initMediaWidget(widget) {
            if (!widget || widget.dataset.mediaInit) return;
            widget.dataset.mediaInit = '1';

            var pickOptions = JSON.parse(widget.dataset.pickOptions || '{}');
            var input      = widget.querySelector('.js-media-input');
            var preview    = widget.querySelector('.js-media-preview .__box-img');
            var nameEl     = widget.querySelector('.js-media-name');
            var sizeEl     = widget.querySelector('.js-media-size');
            var deleteWrap = widget.querySelector('.js-media-delete');
            var btnPick    = widget.querySelector('.js-media-pick');
            var btnClear   = widget.querySelector('.js-media-clear');

            function renderPreview(file) {
                if (!file) {
                    if (preview) preview.innerHTML = '';
                    if (nameEl) nameEl.textContent = '{{ 'sylius_happy_cms.media.no_val'|trans({}, 'SyliusHappyCMSPlugin') }}';
                    if (sizeEl) { sizeEl.textContent = ''; sizeEl.style.display = 'none'; }
                    if (deleteWrap) deleteWrap.style.display = 'none';
                    if (input) input.value = '';
                    return;
                }
                if (preview) {
                    preview.innerHTML = (file.type && file.type.startsWith('image/'))
                        ? '<img src="' + file.download_url + '" loading="lazy">'
                        : '';
                }
                if (nameEl) nameEl.textContent = file.name || '';
                if (sizeEl) {
                    var size = formatFileSize(file.size);
                    sizeEl.textContent = size;
                    sizeEl.style.display = size ? '' : 'none';
                }
                if (deleteWrap) deleteWrap.style.display = '';
                if (input) input.value = file.id;
            }

            btnPick.addEventListener('click', async function () {
                if (!window.EasyMedia) return;
                var file = await window.EasyMedia.pick(pickOptions);
                if (file) renderPreview(file);
            });

            if (btnClear) {
                btnClear.addEventListener('click', function () {
                    renderPreview(null);
                });
            }
        }

        function findAndInit() {
            var widget = document.querySelector(".happy-cms-media-widget[data-widget='" + widgetId + "']");
            initMediaWidget(widget);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', findAndInit);
        } else {
            findAndInit();
        }

        window.addEventListener('sylius-crud:dynamic:reload', function () {
            var widget = document.querySelector(".happy-cms-media-widget[data-widget='" + widgetId + "']");
            if (widget) {
                delete widget.dataset.mediaInit;
                initMediaWidget(widget);
            }
        });
    })();
    </script>
{% endblock %}
