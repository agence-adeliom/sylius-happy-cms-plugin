{% set is_modal = (modal is defined and modal) ? true : false %}
{% set is_browser = (browser is defined and browser) ? true : false %}

{% set features = {
    enableEditor:        (editor is defined and editor is not null) ? editor : true,
    enableUpload:        (upload is defined and upload is not null) ? upload : true,
    enableMove:          (move is defined and move is not null) ? move : true,
    enableRename:        (rename is defined and rename is not null) ? rename : true,
    enableMetas:         (metas is defined and metas is not null) ? metas : true,
    enableDelete:        (delete is defined and delete is not null) ? delete : true,
    enableBulkSelection: (bulk_selection is defined and bulk_selection is not null) ? bulk_selection : true,
    enableGeneratingAlts: sylius_happy_cms.media.enable_generating_alts,
} %}

{% set pick_options = {
    restrictions: {
        path: restrict.path|default(null),
        uploadTypes: restrict.uploadTypes|default(null),
        uploadSize: restrict.uploadSize|default(null),
    },
} %}

<div class="page-wrapper">
    <div id="happy-cms-media-manager"></div>
</div>

<script>
(function () {
    var locale = '{{ app.request.locale|default('fr') }}';
    var config = {{ {
        baseUrl: sylius_happy_cms.media.base_url,
        hideFilesExt: sylius_happy_cms.media.hide_files_ext,
        mimeTypes: sylius_happy_cms.media.extended_mimes,
        generatingAlts: sylius_happy_cms.media.enable_generating_alts,
    }|json_encode|raw }};
    var features = {{ features|json_encode|raw }};
    var routes = {
        files:            '{{ path('media.get_files') }}',
        upload:           '{{ path('media.upload') }}',
        fileInfos:        '{{ path('media.get_file_info') }}',
        uploadCropped:    '{{ path('media.uploadCropped') }}',
        uploadLink:       '{{ path('media.uploadLink') }}',
        newFolder:        '{{ path('media.new_folder') }}',
        deleteFile:       '{{ path('media.delete_file') }}',
        moveFile:         '{{ path('media.move_file') }}',
        renameFile:       '{{ path('media.rename_file') }}',
        editMetas:        '{{ path('media.edit_metas_file') }}',
        generateAlt:      '{{ path('media.generate_alt_file') }}',
        generateAltGroup: '{{ path('media.generate_alt_group') }}',
        generateAllAlt:   '{{ path('media.generate_all_alt') }}',
        globalSearch:     '{{ path('media.global_search') }}',
        folderDownload:   '{{ path('media.folder_download') }}',
        filesDownload:    '{{ path('media.files_download') }}',
    };

    function initManager() {
        if (!window.EasyMedia) return;
        window.EasyMedia.configure({ locale: locale, config: config, features: features, routes: routes });
        window.EasyMedia.mount({ target: '#happy-cms-media-manager' });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initManager);
    } else {
        initManager();
    }
})();
</script>
