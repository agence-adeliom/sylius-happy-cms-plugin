{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% trans_default_domain 'SyliusHappyCMSPlugin' %}

{% block page_title %}{{ 'sylius_happy_cms.media.title'|trans({}, 'SyliusHappyCMSPlugin')|striptags|raw }}{% endblock %}

{# With media.easy_media_manager.enabled, the page is rendered by easy-media-manager (hook
   `sylius_admin.happy_cms.easy_media`) and the assets of the Vue media manager are not loaded. #}
{% block body %}{% if sylius_happy_cms.media.easy_media_manager.enabled ?? false %}
    {% hook 'sylius_admin.happy_cms.easy_media' %}
{% else %}
    {% hook 'sylius_admin.happy_cms.medias' %}
{% endif %}{% endblock %}

{% block metatags %}
    {{ parent() }}
    {# CSRF Token for media manager #}
    <meta name="csrf-token" content="{{ csrf_token }}">
{% endblock %}

{% block stylesheets %}{% if sylius_happy_cms.media.easy_media_manager.enabled ?? false %}{{ parent() }}{% else %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('media-form.css', 'sylius.happy.cms.assets.package') }}"/>
    <style>
        .content-wrapper{
            padding: 0;
        }
    </style>
{% endif %}{% endblock %}

{% block javascripts %}{% if sylius_happy_cms.media.easy_media_manager.enabled ?? false %}{{ parent() }}{% else %}
    {{ parent() }}

    <script src="{{ asset('media-form.js', 'sylius.happy.cms.assets.package') }}"></script>
{% endif %}{% endblock %}
