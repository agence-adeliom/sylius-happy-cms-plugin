{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% trans_default_domain 'SyliusHappyCMSPlugin' %}

{% block page_title %}{{ 'sylius_happy_cms.media.title'|trans({}, 'SyliusHappyCMSPlugin')|striptags|raw }}{% endblock %}

{% block body %}
    {% hook 'sylius_admin.happy_cms.medias' %}
{% endblock %}

{% block metatags %}
    {{ parent() }}
    {# CSRF Token for media manager #}
    <meta name="csrf-token" content="{{ csrf_token }}">
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('media-form.css', 'sylius.happy.cms.assets.package') }}"/>
    <style>
        .content-wrapper{
            padding: 0;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
