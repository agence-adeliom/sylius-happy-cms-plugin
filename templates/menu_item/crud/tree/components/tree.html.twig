{% import '@SyliusAdmin/shared/helper/loader.html.twig' as loader %}

{# Rendered with \App\Twig\Component\Page\PageTreeComponent #}

<div {{ attributes.defaults(stimulus_controller('@agence-adeliom/sylius-happy-cms-plugin/menu-item-tree-tree', {treeData: this.tree|json_encode, autoOpen: true})) }}>
    <div class="card mb-5">
        {{ loader.render() }}
        <div class="card-body">
            <div class="d-none" data-agence-adeliom--sylius-happy-cms-plugin--menu-item-tree-tree-target="itemPrototyp">
                <div class="d-flex justify-content-between infinite-tree-item" {{ sylius_test_html_attribute('menu-item-name', '__PAGE_NAME__') }}>
                    <div class="infinite-tree-node">
                        <span class="infinite-tree-toggler" data-infinite-tree-toggler></span>
                        <span class="infinite-tree-toggler infinite-tree-title" title="__PAGE_NAME__">__PAGE_NAME__</span>
                    </div>

                    {% hook 'tree' %}

                </div>
            </div>
            <div data-agence-adeliom--sylius-happy-cms-plugin--menu-item-tree-tree-target="tree" {{ sylius_test_html_attribute('tree-menu-items') }}></div>
        </div>
    </div>
</div>
