{# The route requires a numeric id, so the placeholder is appended to the URL generated with id 0. #}
{% set builder_url = path('sylius_happy_cms_admin_page_builder', {resource: 'sylius_happy_cms.page', id: 0})|slice(0, -1) ~ '__PAGE_ID__' %}
{% set builder_label = 'sylius_happy_cms.page.admin.action.page_builder'|trans %}

<a href="{{ builder_url }}" class="btn btn-icon btn-sm w-4" title="{{ builder_label }}" aria-label="{{ builder_label }}" data-bs-toggle="tooltip" data-bs-title="{{ builder_label }}" {{ sylius_test_html_attribute('page-builder') }}>
    {{ ux_icon('tabler:layout-grid-add') }}
</a>
