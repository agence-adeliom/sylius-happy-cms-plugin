<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />
        <!-- Put your Behat services here -->

        <service id="tests.adeliom_sylius_happy_cms_plugin.behat.context.page_builder"
                 class="Tests\Adeliom\SyliusHappyCMSPlugin\Behat\Context\PageBuilderContext">
            <argument type="service" id="behat.mink.default_session" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="sylius.happy_cms.command.create_demo_pages" />
            <argument type="service" id="router" />
        </service>
    </services>
</container>
